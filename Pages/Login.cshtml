@page
@model LoginModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Connexion";
}

<style>
    .login-container {
        height: 100vh;
        overflow: hidden;
    }

    .login-visual {
        background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        padding: 3rem;
    }

    .login-visual > * {
        position: relative;
        z-index: 1;
    }

    .login-form-section {
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #ffffff;
        padding: 2rem;
    }

    .login-card {
        width: 100%;
        max-width: 400px;
    }

    .brand-logo {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 1.5rem;
        letter-spacing: -1px;
    }

    .login-title {
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    .login-subtitle {
        color: #64748b;
        margin-bottom: 2rem;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.875rem;
        color: #475569;
    }

    .form-control {
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        border: 1px solid #e2e8f0;
        font-size: 0.95rem;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1);
    }

    .btn-login {
        padding: 0.75rem;
        font-weight: 600;
        border-radius: 0.5rem;
        background-color: #0d6efd;
        border: none;
        transition: all 0.2s;
    }

    .btn-login:hover {
        background-color: #0b5ed7;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.2);
    }

    .welcome-text {
        font-size: 2.5rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 1rem;
    }

    .welcome-desc {
        font-size: 1.1rem;
        text-align: center;
        max-width: 400px;
        opacity: 0.9;
    }

    .toggle-password {
        cursor: pointer;
        color: #94a3b8;
        transition: color 0.2s;
    }

    .toggle-password:hover {
        color: #64748b;
    }

    @@media (max-width: 991.98px) {
        .login-visual {
            display: none;
        }
        .login-container {
            height: auto;
            min-height: 100vh;
        }
    }
</style>

<div class="container-fluid p-0">
    <div class="row g-0 login-container">
        <!-- Left Side: Visual -->
        <div class="col-lg-6 login-visual">
            <div class="brand-logo mb-5">
                SmartCard
            </div>
            <h2 class="welcome-text">Bienvenue sur votre espace de gestion</h2>
            <p class="welcome-desc">
                Simplifiez la gestion de votre flotte et le suivi des consommations de carburant en temps réel.
            </p>
        </div>

        <!-- Right Side: Form -->
        <div class="col-lg-6 login-form-section">
            <div class="login-card">
                <div class="text-center d-lg-none mb-4">
                    <div class="brand-logo text-primary" style="font-size: 2rem;">
                        SmartCard
                    </div>
                </div>
                
                <h1 class="login-title h3">Connexion</h1>
                <p class="login-subtitle">Veuillez entrer vos identifiants pour accéder à votre compte.</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Adresse e-mail</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="far fa-envelope text-muted"></i></span>
                            <input asp-for="Input.Email" type="email" class="form-control border-start-0 ps-0" placeholder="nom@exemple.com" required autofocus>
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label asp-for="Input.Password" class="form-label">Mot de passe</label>
                            <a href="#" class="small text-decoration-none">Oublié ?</a>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
                            <input asp-for="Input.Password" type="password" class="form-control border-start-0 border-end-0 ps-0" id="passwordInput" placeholder="••••••••" required>
                            <span class="input-group-text bg-light border-start-0">
                                <i class="far fa-eye toggle-password" id="togglePassword"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-login w-100 mb-3 mt-4">
                        Se connecter
                    </button>
                </form>

                <footer class="mt-5 text-center text-muted small">
                    &copy; @DateTime.Now.Year - SmartCard System
                </footer>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const togglePassword = document.querySelector('#togglePassword');
            const password = document.querySelector('#passwordInput');

            togglePassword.addEventListener('click', function () {
                const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                password.setAttribute('type', type);
                this.classList.toggle('fa-eye');
                this.classList.toggle('fa-eye-slash');
            });
        });
    </script>
}