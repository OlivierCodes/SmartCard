@page
@model LoginModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Connexion";
    ViewData["BodyClass"] = "auth-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="auth">
    <!-- Panneau visuel (desktop) -->
    <aside class="auth-visual" aria-hidden="true">
        <a href="/" class="auth-brand" tabindex="-1">
            <span class="logo"><i class="fas fa-gas-pump"></i></span>SmartCard
        </a>

        <div class="body">
            <img src="~/images/illustrations/secure-access.svg" class="auth-illu" alt="" />
            <h2>Votre carburant, sous contrôle.</h2>
            <p>Cartes, quotas et consommations de toute votre flotte réunis dans un seul espace sécurisé.</p>
            <ul class="auth-points">
                <li><i class="fas fa-id-card"></i>Gestion des cartes et des employés</li>
                <li><i class="fas fa-sliders"></i>Quotas mensuels contrôlés automatiquement</li>
                <li><i class="fas fa-chart-line"></i>Suivi des consommations en temps réel</li>
            </ul>
        </div>

        <div class="foot">&copy; @DateTime.Now.Year SmartCard System</div>
    </aside>

    <!-- Formulaire -->
    <section class="auth-form">
        <div class="top">
            <a href="/" class="auth-brand dark">
                <span class="logo"><i class="fas fa-gas-pump" aria-hidden="true"></i></span>SmartCard
            </a>
            <a href="/" class="auth-back"><i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Accueil</a>
        </div>

        <div class="auth-card">
            <h1>Bon retour 👋</h1>
            <p class="sub">Connectez-vous pour accéder à votre espace de gestion.</p>

            <form method="post" id="loginForm" novalidate>
                <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

                <div class="auth-field">
                    <label asp-for="Input.Email">Adresse e-mail</label>
                    <div class="auth-input">
                        <i class="far fa-envelope icon" aria-hidden="true"></i>
                        <input asp-for="Input.Email" type="email" class="form-control" placeholder="nom@entreprise.com"
                               autocomplete="username" required autofocus aria-describedby="emailError" />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-error" id="emailError"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.Password">Mot de passe</label>
                    <div class="auth-input">
                        <i class="fas fa-lock icon" aria-hidden="true"></i>
                        <input asp-for="Input.Password" type="password" class="form-control" id="passwordInput" placeholder="••••••••"
                               autocomplete="current-password" required aria-describedby="passwordError capsWarning" />
                        <button type="button" class="auth-toggle" id="togglePassword" aria-label="Afficher le mot de passe" aria-pressed="false">
                            <i class="far fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="field-error" id="passwordError"></span>
                    <span class="caps-warning" id="capsWarning" role="status"><i class="fas fa-triangle-exclamation me-1" aria-hidden="true"></i>La touche Verr. Maj est activée.</span>
                </div>

                <div class="auth-row">
                    <div class="form-check m-0">
                        <input asp-for="Input.RememberMe" class="form-check-input" type="checkbox" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Se souvenir de moi</label>
                    </div>
                    <button type="button" class="auth-help" data-bs-toggle="collapse" data-bs-target="#forgotHelp" aria-expanded="false" aria-controls="forgotHelp">
                        Mot de passe oublié ?
                    </button>
                </div>
                <div class="collapse" id="forgotHelp">
                    <div class="auth-help-text">
                        <i class="fas fa-circle-info me-1" aria-hidden="true"></i>
                        Contactez l'administrateur SmartCard de votre entreprise pour réinitialiser votre mot de passe.
                    </div>
                </div>

                <button type="submit" class="btn-auth" id="submitBtn">
                    <span class="spinner-border" role="status" aria-hidden="true"></span>
                    <span class="label">Se connecter</span>
                    <i class="fas fa-arrow-right arrow" aria-hidden="true"></i>
                </button>

                <div class="auth-secure">
                    <i class="fas fa-shield-alt" aria-hidden="true"></i>Connexion sécurisée et chiffrée
                </div>
            </form>
        </div>

        <footer class="auth-footer">&copy; @DateTime.Now.Year SmartCard System &middot; <a href="/Privacy" class="text-reset">Confidentialité</a></footer>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('loginForm');
            var email = document.getElementById('Input_Email');
            var password = document.getElementById('passwordInput');
            var toggle = document.getElementById('togglePassword');
            var caps = document.getElementById('capsWarning');
            var submit = document.getElementById('submitBtn');

            // Afficher / masquer le mot de passe
            toggle.addEventListener('click', function () {
                var show = password.type === 'password';
                password.type = show ? 'text' : 'password';
                toggle.setAttribute('aria-pressed', show);
                toggle.setAttribute('aria-label', show ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
                toggle.querySelector('i').className = show ? 'far fa-eye-slash' : 'far fa-eye';
                password.focus();
            });

            // Avertissement Verr. Maj
            function checkCaps(e) {
                if (e.getModifierState) caps.classList.toggle('show', e.getModifierState('CapsLock'));
            }
            password.addEventListener('keyup', checkCaps);
            password.addEventListener('keydown', checkCaps);
            password.addEventListener('blur', function () { caps.classList.remove('show'); });

            // Messages d'erreur clairs avant l'envoi
            function setError(input, id, message) {
                var el = document.getElementById(id);
                el.textContent = message;
                input.classList.toggle('input-validation-error', !!message);
                input.setAttribute('aria-invalid', message ? 'true' : 'false');
            }
            [email, password].forEach(function (input) {
                input.addEventListener('input', function () {
                    setError(input, input === email ? 'emailError' : 'passwordError', '');
                });
            });

            form.addEventListener('submit', function (e) {
                var ok = true;
                if (!email.value.trim()) {
                    setError(email, 'emailError', 'Veuillez saisir votre adresse e-mail.'); ok = false;
                } else if (!email.checkValidity()) {
                    setError(email, 'emailError', 'Cette adresse e-mail ne semble pas valide.'); ok = false;
                }
                if (!password.value) {
                    setError(password, 'passwordError', 'Veuillez saisir votre mot de passe.'); ok = false;
                }
                if (!ok) {
                    e.preventDefault();
                    (email.classList.contains('input-validation-error') ? email : password).focus();
                    return;
                }
                // État de chargement
                submit.classList.add('loading');
                submit.disabled = true;
                submit.querySelector('.label').textContent = 'Connexion…';
            });
        });
    </script>
}
